{
  "openapi": "3.1.0",
  "info": {
    "title": "Helius Decryption Service API",
    "description": "The gatekeeper front of the decryption enclave. A session returns discovery, the ping, and the Boot Proof of the replica that answered. An operation forwards the encrypted request and returns that replica's Boot Proof. The client verifies both against the release it pins.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1"
  },
  "servers": [
    {
      "url": "https://devnet.helius-rpc.com",
      "description": "Devnet"
    },
    {
      "url": "https://mainnet.helius-rpc.com",
      "description": "Mainnet"
    }
  ],
  "paths": {
    "/v1/decryption/operations": {
      "post": {
        "tags": [
          "Decryption service"
        ],
        "summary": "Run a decryption-service operation",
        "description": "Forwards the client's encrypted request as it is and returns the Boot\nProof of the replica that answered. A resent request gets the first\nrequest's answer, marked `Idempotent-Replayed`.",
        "operationId": "decryption_operations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecryptionEncryptedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The enclave's answer and its evidence",
            "headers": {
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string"
                },
                "description": "`true` when the answer repeats an earlier request's"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operated"
                }
              }
            }
          },
          "4XX": {
            "description": "Refused, or the enclave or Turnkey did not answer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decryption/session": {
      "post": {
        "tags": [
          "Decryption service"
        ],
        "summary": "Open a decryption-service session",
        "description": "Discovery, the enclave's answer to the ping and the Boot Proof of the\nreplica that answered. The decryption service authorizes with a Solana\nsignature on decrypt requests.",
        "operationId": "decryption_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The evidence to verify",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "4XX": {
            "description": "Refused, or the enclave or Turnkey did not answer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecryptionEncryptedRequest": {
        "type": "object",
        "description": "The enclave's `EncryptedRequest` (OpenAPI shape).",
        "required": [
          "version",
          "quorum_key_id",
          "quorum_key_epoch",
          "ciphertext"
        ],
        "properties": {
          "ciphertext": {
            "type": "string",
            "description": "Hex ciphertext."
          },
          "quorum_key_epoch": {
            "type": "string",
            "description": "Decimal string of the quorum key epoch."
          },
          "quorum_key_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Operated": {
        "type": "object",
        "description": "The enclave's encrypted response and the Boot Proof of the replica that\nanswered.",
        "required": [
          "response",
          "bootProof"
        ],
        "properties": {
          "bootProof": {
            "type": "object",
            "description": "Turnkey's Boot Proof for the replica that signed `response`."
          },
          "response": {
            "type": "object",
            "description": "The enclave's `EncryptedResponse`."
          }
        }
      },
      "PingRequest": {
        "type": "object",
        "description": "The enclave's `QosPingRequest`.",
        "required": [
          "version",
          "encrypted_challenge"
        ],
        "properties": {
          "encrypted_challenge": {
            "type": "string",
            "description": "A random challenge in a QOS P-256 envelope to the release's quorum key, hex."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem; `type` is omitted, so it is `about:blank`.",
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "What went wrong, for a program to act on.",
            "enum": [
              "InvalidJson",
              "OriginAuthRequired",
              "ProjectRequired",
              "ApiKeyRequired",
              "ApiKeyInvalid",
              "WaasNotEnabled",
              "NotFound",
              "OperationInProgress",
              "RequestTooLarge",
              "TooManyInFlight",
              "EnclaveUnavailable",
              "InvalidEnclaveAnswer",
              "UpstreamResponseTooLarge",
              "BootProofUnavailable",
              "TurnkeyUnavailable",
              "TurnkeyUnauthorized",
              "TurnkeyRateLimited",
              "ReplayGuardUnavailable",
              "ApiKeyLookupUnavailable"
            ]
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "The HTTP status phrase."
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "The enclave's discovery document, its answer to the client's encrypted\nping, and the Boot Proof of the replica that answered.",
        "required": [
          "info",
          "ping",
          "bootProof"
        ],
        "properties": {
          "bootProof": {
            "type": "object",
            "description": "Turnkey's Boot Proof for the replica that signed `ping`."
          },
          "info": {
            "type": "object",
            "description": "The enclave's `ServiceInfo`."
          },
          "ping": {
            "type": "object",
            "description": "The enclave's `QosPingResponse`."
          }
        }
      }
    },
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "query",
        "name": "api-key",
        "description": "Your Helius API key."
      }
    }
  },
  "security": [
    {
      "api-key": []
    }
  ]
}
