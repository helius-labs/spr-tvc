{
  "name": "@heliuslabs/spr-decryption-service",
  "version": "0.2.0-alpha.0",
  "description": "Client for the attested Solana Privacy Rings decryption service",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/spr-tvc.git",
    "directory": "sdk"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "import": "./dist/release.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@turnkey/crypto": "2.11.3",
    "@turnkey/sdk-types": "1.5.1"
  },
  "peerDependencies": {
    "@heliuslabs/spr": "^0.9.0-alpha",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@solana/kit": "^8.3.0",
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
